<%- include('partials/header', { currentPage: 'dashboard' , selectedProfile, profiles }) %>

<style>
    /* Button Styles */
    .accordion-container {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .accordion-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .accordion-item:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .accordion-header {
        padding: 1rem;
        cursor: pointer;
        background: #f8fafc;
        transition: background 0.2s ease;
    }

    .accordion-header:hover {
        background: #f1f5f9;
    }

    .accordion-summary {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .summary-date {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        font-size: 0.85rem;
        min-width: 140px;
    }

    .summary-date .time {
        color: #94a3b8;
        font-size: 0.75rem;
    }

    .summary-campaign {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: 1;
        min-width: 200px;
    }

    .summary-campaign i {
        color: #3b82f6;
    }

    .campaign-name {
        font-weight: 600;
        color: #1e293b;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .campaign-id {
        color: #94a3b8;
        font-size: 0.75rem;
        font-family: monospace;
    }

    .summary-rule {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        font-size: 0.85rem;
    }

    .summary-rule i {
        color: #f59e0b;
    }

    .rule-name {
        font-weight: 500;
    }

    .summary-actions {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
    }

    .action-badge-mini {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        background: #e2e8f0;
        color: #475569;
    }

    .action-badge-mini.increase-bid,
    .action-badge-mini.increase-budget {
        background: #dcfce7;
        color: #166534;
    }

    .action-badge-mini.decrease-bid,
    .action-badge-mini.decrease-budget {
        background: #fee2e2;
        color: #991b1b;
    }

    .action-badge-mini.pause-campaign,
    .action-badge-mini.pause-keyword {
        background: #fef3c7;
        color: #92400e;
    }

    .accordion-toggle {
        margin-left: auto;
        color: #64748b;
        transition: transform 0.2s ease;
    }

    .accordion-toggle i {
        transition: transform 0.3s ease;
    }

    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .accordion-inner {
        padding: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .reasoning-box {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
        border-radius: 0 4px 4px 0;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .reasoning-box i {
        color: #3b82f6;
        margin-top: 0.2rem;
    }

    .reasoning-box span {
        color: #1e40af;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .adjustments-section {
        margin-bottom: 1rem;
    }

    .adjustments-section h4 {
        margin: 0 0 0.75rem 0;
        font-size: 0.9rem;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .adjustments-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .adjustment-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 6px;
        border-left: 3px solid #e5e7eb;
    }

    .adjustment-item.increase-bid,
    .adjustment-item.increase-budget {
        border-left-color: #22c55e;
    }

    .adjustment-item.decrease-bid,
    .adjustment-item.decrease-budget {
        border-left-color: #ef4444;
    }

    .action-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .action-badge.increase-bid,
    .action-badge.increase-budget {
        background: #dcfce7;
        color: #166534;
    }

    .action-badge.decrease-bid,
    .action-badge.decrease-budget {
        background: #fee2e2;
        color: #991b1b;
    }

    .adj-target {
        color: #6b7280;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .adj-change {
        margin-left: auto;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .adj-change.positive {
        color: #16a34a;
    }

    .adj-change.negative {
        color: #dc2626;
    }

    .log-footer {
        display: flex;
        justify-content: flex-end;
        padding-top: 0.75rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-small {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #111d33;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        transition: background 0.2s ease;
    }

    .btn-small:hover {
        background: #0d172a;
    }
</style>

    <div class="page-header">
        <h2>Dashboard</h2>
        <div class="actions">
            <button onclick="reportSync()" class="btn">
                <i class="fas fa-sync-alt"></i>
                Sync Report
            </button>
            <button onclick="dailyAdjust()" class="btn btn-primary">
                <i class="fas fa-calendar-day"></i>
                Daily Adjust
            </button>
            <button onclick="adjustBids()" class="btn btn-primary">
                <i class="fas fa-bolt"></i>
                Adjust Bids Now
            </button>
        </div>
    </div>
    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Campaigns</h3>
            <p class="stat-value">
                <%= stats.totalCampaigns %>
            </p>
        </div>
        <div class="stat-card">
            <h3>Active Campaigns</h3>
            <p class="stat-value">
                <%= stats.activeCampaigns %>
            </p>
        </div>
        <div class="stat-card">
            <h3>Total Spend</h3>
            <p class="stat-value">₹<%= stats.totalSpend.toFixed(2) %>
            </p>
        </div>
        <div class="stat-card">
            <h3>Total Sales</h3>
            <p class="stat-value">₹<%= stats.totalSales.toFixed(2) %>
            </p>
        </div>
        <div class="stat-card">
            <h3>Average ROAS</h3>
            <p class="stat-value <%= stats.averageROI >= 3 ? 'high-roi' : stats.averageROI <= 1 ? 'low-roi' : '' %>">
                <%= stats.averageROI.toFixed(2) %>
            </p>
        </div>
        <div class="stat-card">
            <h3>Acos</h3>
            <p class="stat-value <%= stats.acos14 >= 3 ? 'high-roi' : stats.acos14 <= 1 ? 'low-acos' : '' %>">
                <%= stats.acos14.toFixed(2) %>
            </p>
        </div>
    </div>

    <div class="section">
        <h3>Active Campaigns</h3>
        <div class="table-responsive">
            <table class="campaign-table">
                <thead>
                    <tr>
                        <th>Campaign ID</th>

                        <th>Campaign</th>
                        <th>Budget</th>
                        <!-- <th>ROI</th> -->
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (campaigns && campaigns.length> 0) { %>
                        <% campaigns.slice(0, 5).forEach(campaign=> { %>
                            <tr>
                                <td>
                                    <%= campaign.campaignId %>
                                </td>
                                <td>
                                    <%= campaign.name %>
                                </td>
                                <td>$<%= campaign.budget.budget %>
                                </td>
                                <td>
                                    <span class="status-badge <%= campaign.state %>">
                                        <%= campaign.state %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/campaigns/<%= campaign.campaignId %>" class="btn-small">View</a>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="no-data">No active campaigns found</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
        <a href="/campaigns" class="btn">View All Campaigns</a>
    </div>

    <div class="section">
        <h3>Recent Optimizations</h3>
        <link rel="stylesheet" href="/css/log-list.css">
        <%- include('partials/log-list', { logs: recentLogs || [], campaignMap: campaignMap, limit: 5 }) %>
        <a href="/logs" class="btn" style="margin-top: 20px;">View All Logs</a>
    </div>

    <script>
        async function reportSync() {
            // Show custom confirmation modal
            showConfirmationModal(
                'Confirm Sync from Amazon',
                'Sync campaign data from Amazon? This will update all campaign information.',
                async () => {
                    const button = event.target;
                    const originalText = button.innerHTML;

                    // Show loading state
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Syncing...';
                    button.disabled = true;

                    try {
                        const response = await fetch('/api/campaigns/report-sync', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        const result = await response.json();

                        if (response.ok) {
                            // Show success message
                            button.innerHTML = '<i class="fas fa-check"></i> Sync Complete';
                            button.style.background = '#4caf50';

                            // Show notification
                            showNotification(`Sync completed successfully! ${result.message}`, 'success');

                            // Reload page after 2 seconds to show updated data
                            setTimeout(() => {
                                location.reload();
                            }, 2000);
                        } else {
                            throw new Error(result.message || 'Sync failed');
                        }
                    } catch (error) {
                        console.error('Sync error:', error);
                        showNotification(`Error syncing campaigns: ${error.message}`, 'error');

                        // Reset button
                        button.innerHTML = originalText;
                        button.disabled = false;
                        button.style.background = '';
                    }
                }
            );
        }

        async function adjustBids() {
            // Show custom confirmation modal
            showConfirmationModal(
                'Confirm Bid Adjustment',
                'Manually trigger bid adjustment for all campaigns? This will analyze performance and adjust bids automatically.',
                async () => {
                    const button = event.target;
                    const originalText = button.innerHTML;

                    // Show loading state
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adjusting...';
                    button.disabled = true;

                    try {
                        const response = await fetch('/api/campaigns/adjust-bids', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        const result = await response.json();

                        if (response.ok) {
                            // Show success message
                            button.innerHTML = '<i class="fas fa-check"></i> Adjustment Complete';
                            button.style.background = '#4caf50';

                            // Show notification
                            showNotification(`Bid adjustment completed successfully! ${result.message}`, 'success');

                            // Reload page after 2 seconds to show updated data
                            setTimeout(() => {
                                location.reload();
                            }, 2000);
                        } else {
                            throw new Error(result.message || 'Bid adjustment failed');
                        }
                    } catch (error) {
                        console.error('Bid adjustment error:', error);
                        showNotification(`Error adjusting bids: ${error.message}`, 'error');

                        // Reset button
                        button.innerHTML = originalText;
                        button.disabled = false;
                        button.style.background = '';
                    }
                }
            );
        }

        async function dailyAdjust() {
            // Show custom confirmation modal
            showConfirmationModal(
                'Confirm Daily Adjustment',
                'Run daily optimization rules? This will check budget exhaustion, out-of-stock products, and negative keyword detection for all campaigns.',
                async () => {
                    const button = event.target;
                    const originalText = button.innerHTML;

                    // Show loading state
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Running...';
                    button.disabled = true;

                    try {
                        const response = await fetch('/api/campaigns/daily-adjust', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            // Show success message
                            button.innerHTML = '<i class="fas fa-check"></i> Complete';
                            button.style.background = '#4caf50';

                            // Show notification
                            showNotification(`Daily adjustment completed successfully!`, 'success');

                            // Reload page after 2 seconds to show updated data
                            setTimeout(() => {
                                location.reload();
                            }, 2000);
                        } else {
                            throw new Error(result.message || 'Daily adjustment failed');
                        }
                    } catch (error) {
                        console.error('Daily adjustment error:', error);
                        showNotification(`Error: ${error.message}`, 'error');

                        // Reset button
                        button.innerHTML = originalText;
                        button.disabled = false;
                        button.style.background = '';
                    }
                }
            );
        }

        // Confirmation Modal Functions
        function showConfirmationModal(title, message, onConfirm) {
            // Remove any existing modals
            const existingModal = document.querySelector('.confirmation-modal');
            if (existingModal) existingModal.remove();

            // Create modal overlay
            const overlay = document.createElement('div');
            overlay.className = 'modal-overlay';

            // Create modal content
            const modal = document.createElement('div');
            modal.className = 'confirmation-modal';
            modal.innerHTML = `
            <div class="modal-content">
                <div class="modal-header">
                    <h3>${title}</h3>
                    <button class="modal-close" onclick="closeConfirmationModal()">×</button>
                </div>
                <div class="modal-body">
                    <p>${message}</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeConfirmationModal()">Cancel</button>
                    <button class="btn btn-danger" onclick="confirmAction()">Confirm</button>
                </div>
            </div>
        `;

            // Add to document
            document.body.appendChild(overlay);
            document.body.appendChild(modal);

            // Store the confirm callback
            window.confirmationCallback = onConfirm;
        }

        function closeConfirmationModal() {
            const modal = document.querySelector('.confirmation-modal');
            const overlay = document.querySelector('.modal-overlay');

            if (modal) modal.remove();
            if (overlay) overlay.remove();

            // Clean up callback
            delete window.confirmationCallback;
        }

        function confirmAction() {
            if (window.confirmationCallback) {
                window.confirmationCallback();
            }
            closeConfirmationModal();
        }

        // Close modal when clicking outside
        document.addEventListener('click', function (e) {
            const modal = document.querySelector('.confirmation-modal');
            const overlay = document.querySelector('.modal-overlay');

            if (overlay && e.target === overlay) {
                closeConfirmationModal();
            }
        });

        // Accordion toggle function
        function toggleAccordion(header) {
            const item = header.parentElement;
            const content = item.querySelector('.accordion-content');
            const toggle = header.querySelector('.accordion-toggle i');
            
            // Close all other accordions
            document.querySelectorAll('.accordion-item').forEach(otherItem => {
                if (otherItem !== item) {
                    otherItem.classList.remove('active');
                    otherItem.querySelector('.accordion-content').style.maxHeight = null;
                    otherItem.querySelector('.accordion-toggle i').style.transform = 'rotate(0deg)';
                }
            });
            
            // Toggle current accordion
            item.classList.toggle('active');
            if (item.classList.contains('active')) {
                content.style.maxHeight = content.scrollHeight + 'px';
                toggle.style.transform = 'rotate(180deg)';
            } else {
                content.style.maxHeight = null;
                toggle.style.transform = 'rotate(0deg)';
            }
        }

        // Group toggle function
        function toggleGroup(header) {
            const group = header.parentElement;
            const isActive = group.classList.contains('active');
            
            // Close all groups
            document.querySelectorAll('.campaign-date-group').forEach(g => {
                g.classList.remove('active');
            });
            
            // Open clicked group if it wasn't active
            if (!isActive) {
                group.classList.add('active');
            }
        }

        // Log entry toggle function
        function toggleLogEntry(header) {
            const logEntry = header.parentElement;
            const isActive = logEntry.classList.contains('active');
            
            // Close all log entries in this group
            const group = logEntry.closest('.group-inner');
            if (group) {
                group.querySelectorAll('.log-entry').forEach(entry => {
                    entry.classList.remove('active');
                });
            }
            
            // Open clicked entry if it wasn't active
            if (!isActive) {
                logEntry.classList.add('active');
            }
        }

        // Open first group by default
        document.addEventListener('DOMContentLoaded', function() {
            const firstGroup = document.querySelector('.campaign-date-group');
            if (firstGroup) {
                firstGroup.classList.add('active');
            }
        });

        // Notification function
        function showNotification(message, type = 'info') {
            // Remove any existing notifications
            const existingNotifications = document.querySelectorAll('.notification');
            existingNotifications.forEach(notification => notification.remove());

            // Create notification element
            const notification = document.createElement('div');
            notification.className = `notification notification-${type}`;
            notification.innerHTML = `
            <span class="notification-message">${message}</span>
            <button class="notification-close" onclick="this.parentElement.remove()">×</button>
        `;

            // Add to top of body
            document.body.appendChild(notification);

            // Auto-remove after 5 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 5000);
        }
    </script>

    <%- include('partials/footer') %>