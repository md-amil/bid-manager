<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= campaign ? campaign.campaignName : 'Campaign' %> - Details</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { selectedProfile, profiles, currentPage: 'campaigns' }) %>
    
    <main class="container">
        <% if (campaign) { %>
            <a href="/campaigns" class="back-link-compact">← Back</a>

            <!-- Campaign Info Header Card -->
            <div class="campaign-header-card">
                <div class="info-item">
                    <span class="info-label">Campaign:</span>
                    <span class="info-value campaign-name"><%= campaign.name %></span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">ID:</span>
                    <span class="info-value"><%= campaign.campaignId %></span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">Budget:</span>
                    <span class="info-value">
                        <% if (campaign.budget) { %>
                            $<%= campaign.budget.budget %>
                        <% } else { %>
                            N/A
                        <% } %>
                    </span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">Budget Type:</span>
                    <span class="info-value"><%= campaign.budgetType || 'N/A' %></span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">Targeting:</span>
                    <span class="info-value"><%= campaign.targetingType || 'N/A' %></span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">Start:</span>
                    <span class="info-value">
                        <%= campaign.startDate ? new Date(campaign.startDate).toLocaleDateString() : 'N/A' %>
                    </span>
                </div>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">End:</span>
                    <span class="info-value">
                        <%= campaign.endDate ? new Date(campaign.endDate).toLocaleDateString() : 'Ongoing' %>
                    </span>
                </div>
                <% if (campaign.portfolioId) { %>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">Portfolio:</span>
                    <span class="info-value"><%= campaign.portfolioId %></span>
                </div>
                <% } %>
                <div class="info-divider"></div>
                <div class="info-item">
                    <span class="info-label">State:</span>
                    <span class="status-badge <%= campaign.state ? campaign.state.toLowerCase() : '' %>">
                        <%= campaign.state || 'N/A' %>
                    </span>
                </div>
                <% if (campaign.state === 'ENABLED') { %>
                <div class="info-divider"></div>
                <div class="info-item">
                    <button type="button" onclick="adjustCampaignBid('<%= campaign.campaignId %>', '<%= campaign.name %>')" class="btn-adjust-bid" id="adjustBidBtn">
                        ⚡ Adjust Bid
                    </button>
                </div>
                <% } %>
            </div>

            <!-- Campaign Performance Metrics -->
            <% if (metrics) { %>
            <div class="section">
                <div class="section-header">
                    <h3>Performance Metrics</h3>
                    <div class="filter-controls">
                        <div class="filter-tabs">
                            <button class="filter-tab <%= (!period || period === 'daily') ? 'active' : '' %>" onclick="window.location.href='/campaigns/<%= campaignId %>?period=daily'">Daily</button>
                            <button class="filter-tab <%= period === 'weekly' ? 'active' : '' %>" onclick="window.location.href='/campaigns/<%= campaignId %>?period=weekly'">Weekly</button>
                            <button class="filter-tab <%= period === 'monthly' ? 'active' : '' %>" onclick="window.location.href='/campaigns/<%= campaignId %>?period=monthly'">Monthly</button>
                        </div>
                        <div class="date-filter">
                            <input type="date" id="startDate" class="date-input" value="<%= startDate || '' %>" />
                            <span class="date-separator">to</span>
                            <input type="date" id="endDate" class="date-input" value="<%= endDate || '' %>" />
                            <button class="btn-filter" onclick="applyDateFilter()">Apply</button>
                        </div>
                    </div>
                </div>
                <script>
                    function applyDateFilter() {
                        const startDate = document.getElementById('startDate').value;
                        const endDate = document.getElementById('endDate').value;
                        if (startDate && endDate) {
                            window.location.href = '/campaigns/<%= campaignId %>?period=custom&startDate=' + startDate + '&endDate=' + endDate;
                        } else {
                            alert('Please select both start and end dates');
                        }
                    }
                </script>
                <div class="metrics-list">
                    <div class="metric-card-compact">
                        <div class="metric-icon">📊</div>
                        <div class="metric-content">
                            <span class="metric-label">Impressions</span>
                            <span class="metric-value"><%= metrics.impressions.toLocaleString() %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">👆</div>
                        <div class="metric-content">
                            <span class="metric-label">Clicks</span>
                            <span class="metric-value"><%= metrics.clicks.toLocaleString() %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">💰</div>
                        <div class="metric-content">
                            <span class="metric-label">Spend</span>
                            <span class="metric-value">$<%= metrics.spend.toFixed(2) %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">💵</div>
                        <div class="metric-content">
                            <span class="metric-label">Sales (14d)</span>
                            <span class="metric-value">$<%= metrics.sales14d.toFixed(2) %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">🎯</div>
                        <div class="metric-content">
                            <span class="metric-label">CPC</span>
                            <span class="metric-value">$<%= metrics.costPerClick.toFixed(2) %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">📈</div>
                        <div class="metric-content">
                            <span class="metric-label">CTR</span>
                            <span class="metric-value"><%= metrics.clickThroughRate.toFixed(2) %>%</span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">🔄</div>
                        <div class="metric-content">
                            <span class="metric-label">ROAS (14d)</span>
                            <span class="metric-value"><%= metrics.roas14d.toFixed(2) %></span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">📉</div>
                        <div class="metric-content">
                            <span class="metric-label">ACOS (14d)</span>
                            <span class="metric-value"><%= metrics.acos14d.toFixed(2) %>%</span>
                        </div>
                    </div>
                    <div class="metric-card-compact">
                        <div class="metric-icon">✅</div>
                        <div class="metric-content">
                            <span class="metric-label">Conversions (14d)</span>
                            <span class="metric-value"><%= metrics.conversions14d %></span>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Ad Groups Section -->
            <div class="section">
                <h3>Ad Groups</h3>
                <% if (adGroups && adGroups.length > 0) { %>
                    <div class="table-responsive">
                        <table class="adgroup-table">
                            <thead>
                                <tr>
                                    <th>Ad Group</th>
                                    <th>State</th>
                                    <th>Default Bid</th>
                                    <th>Impressions</th>
                                    <th>Clicks</th>
                                    <th>Cost</th>
                                    <th>Sales 7d</th>
                                    <th>Sales 14d</th>
                                    <th>ACOS</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% adGroups.forEach(adGroup => { %>
                                    <tr>
                                        <td>
                                            <div class="adgroup-info">
                                                <div class="adgroup-name"><%= adGroup.name %></div>
                                                <div class="adgroup-id">ID: <%= adGroup.adGroupId %></div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-badge <%= adGroup.state.toLowerCase() %>">
                                                <%= adGroup.state %>
                                            </span>
                                        </td>
                                        <td class="metric-cell">
                                            <%= adGroup.defaultBid ? '₹' + adGroup.defaultBid : '-' %>
                                        </td>
                                        <td class="metric-cell">
                                            <%= adGroup.metrics ? adGroup.metrics.impressions.toLocaleString() : '-' %>
                                        </td>
                                        <td class="metric-cell">
                                            <%= adGroup.metrics ? adGroup.metrics.clicks.toLocaleString() : '-' %>
                                        </td>
                                        <td class="metric-cell cost">
                                            <%= adGroup.metrics ? '₹' + adGroup.metrics.cost.toLocaleString() : '-' %>
                                        </td>
                                        <td class="metric-cell sales">
                                            <%= adGroup.metrics ? '₹' + adGroup.metrics.sales7d.toLocaleString() : '-' %>
                                        </td>
                                        <td class="metric-cell sales">
                                            <%= adGroup.metrics ? '₹' + adGroup.metrics.sales14d.toLocaleString() : '-' %>
                                        </td>
                                        <td class="metric-cell acos">
                                            <% if (adGroup.metrics && adGroup.metrics.acos14d > 0) { %>
                                                <span class="acos-badge <%= adGroup.metrics.acos14d < 20 ? 'good' : adGroup.metrics.acos14d < 40 ? 'medium' : 'bad' %>">
                                                    <%= adGroup.metrics.acos14d %>
                                                </span>
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/campaigns/<%= campaignId %>/adgroups/<%= adGroup.adGroupId %>" class="btn-small">View</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="no-data">No ad groups found for this campaign.</p>
                <% } %>
            </div>

            <div class="section">
                <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0;">Optimization History</h3>
                    <% if (logs && logs.length > 0) { %>
                        <button type="button" onclick="clearOptimizationLogs()" class="btn-clear-logs" id="clearLogsBtn">
                            🗑️ Clear Logs
                        </button>
                    <% } %>
                </div>
                <% if (logs && logs.length > 0) { %>
                    <div class="accordion-container">
                        <% logs.forEach((log, index) => { %>
                            <div class="accordion-item">
                                <div class="accordion-header" onclick="toggleAccordion(this)">
                                    <div class="accordion-summary">
                                        <div class="summary-date">
                                            <i class="fas fa-calendar"></i>
                                            <span><%= new Date(log.createdAt).toLocaleDateString() %></span>
                                            <span class="time"><%= new Date(log.createdAt).toLocaleTimeString() %></span>
                                        </div>
                                        <div class="summary-rule">
                                            <i class="fas fa-cog"></i>
                                            <span class="rule-name"><%= log.ruleName || 'Rule' %></span>
                                            <span class="rule-id">ID: <%= log.ruleId || 'N/A' %></span>
                                        </div>
                                        <div class="summary-actions">
                                            <% if (log.adjustments && log.adjustments.length > 0) { %>
                                                <% log.adjustments.forEach(adj => { %>
                                                    <span class="action-badge-mini <%= adj.action.toLowerCase().replace(/_/g, '-') %>">
                                                        <%= adj.action.replace(/_/g, ' ') %>
                                                    </span>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                        <div class="accordion-toggle">
                                            <i class="fas fa-chevron-down"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-content">
                                    <div class="accordion-inner">
                                        <!-- <div class="log-meta">
                                            <div class="meta-item">
                                                <i class="fas fa-hashtag"></i>
                                                <span class="meta-label">Rule ID:</span>
                                                <span class="meta-value"><%= log.ruleId || 'N/A' %></span>
                                            </div>
                                            <div class="meta-item">
                                                <i class="fas fa-tag"></i>
                                                <span class="meta-label">Rule Name:</span>
                                                <span class="meta-value"><%= log.ruleName || 'N/A' %></span>
                                            </div>
                                        </div> -->
                                        
                                        <% if (log.reasoning) { %>
                                            <div class="reasoning-box">
                                                <i class="fas fa-lightbulb"></i>
                                                <span><%= log.reasoning %></span>
                                            </div>
                                        <% } %>
                                        
                                        <!-- <% if (log.adjustments && log.adjustments.length > 0) { %>
                                            <div class="adjustments-section">
                                                <h4><i class="fas fa-list-ul"></i> Adjustments</h4>
                                                <div class="adjustments-list">
                                                    <% log.adjustments.forEach(adj => { %>
                                                        <div class="adjustment-item <%= adj.action.toLowerCase().replace(/_/g, '-') %>">
                                                            <div class="adj-action">
                                                                <span class="action-badge <%= adj.action.toLowerCase().replace(/_/g, '-') %>">
                                                                    <%= adj.action.replace(/_/g, ' ') %>
                                                                </span>
                                                            </div>
                                                            <% if (adj.target) { %>
                                                                <div class="adj-target">
                                                                    <i class="fas fa-crosshairs"></i>
                                                                    <%= adj.target %>
                                                                </div>
                                                            <% } %>
                                                            <% if (adj.change !== null && adj.change !== undefined) { %>
                                                                <div class="adj-change <%= adj.change > 0 ? 'positive' : 'negative' %>">
                                                                    <i class="fas fa-<%= adj.change > 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                                                                    <%= adj.change > 0 ? '+' : '' %><%= adj.change.toFixed(1) %>%
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } %> -->

                                        <% if (log.adjustments && log.adjustments.length > 0) { %>
                                            <% log.adjustments.forEach((adj, adjIndex) => { 
                                                // Determine which entities to show based on adj.target
                                                let entities = [];
                                                let entityType = 'unknown';
                                                let isCampaignAdjustment = false;
                                                
                                                // Check if this is a campaign-level adjustment (budget, pause, etc.)
                                                const campaignActions = ['INCREASE_BUDGET', 'DECREASE_BUDGET', 'PAUSE_CAMPAIGN', 'RESUME_CAMPAIGN'];
                                                if (campaignActions.includes(adj.action) || adj.target === 'other' || !adj.target) {
                                                    isCampaignAdjustment = true;
                                                    entityType = 'campaign';
                                                } else if (adj.target === 'targetings' && log.targetings && log.targetings.length > 0) {
                                                    entities = log.targetings;
                                                    entityType = 'target';
                                                } else if (adj.target === 'keywords' && log.keywords && log.keywords.length > 0) {
                                                    entities = log.keywords;
                                                    entityType = 'keyword';
                                                } else if (adj.target === 'searchTerms' && log.searchTerms && log.searchTerms.length > 0) {
                                                    entities = log.searchTerms;
                                                    entityType = 'search-term';
                                                }
                                            %>
                                                <div class="adjustments-table-section">
                                                    <div class="adjustment-header-row">
                                                        <h4>
                                                            <i class="fas fa-<%= isCampaignAdjustment ? 'bullhorn' : 'table' %>"></i> 
                                                            <% if (isCampaignAdjustment) { %>
                                                                Campaign Adjustment
                                                            <% } else { %>
                                                                <%= adj.target ? adj.target.charAt(0).toUpperCase() + adj.target.slice(1).replace(/s$/, '') : 'Entity' %> Adjustment
                                                            <% } %>
                                                        </h4>
                                                        <div class="adjustment-meta">
                                                            <span class="action-badge <%= adj.action ? adj.action.toLowerCase().replace(/_/g, '-') : '' %>">
                                                                <%= adj.action ? adj.action.replace(/_/g, ' ') : 'N/A' %>
                                                            </span>
                                                            <% if (adj.change !== undefined && adj.change !== null) { %>
                                                                <span class="change-badge <%= adj.change > 0 ? 'increase' : adj.change < 0 ? 'decrease' : 'neutral' %>">
                                                                    <i class="fas fa-<%= adj.change > 0 ? 'arrow-up' : adj.change < 0 ? 'arrow-down' : 'minus' %>"></i>
                                                                    <%= adj.change > 0 ? '+' : '' %><%= adj.change.toFixed(1) %>%
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    
                                                    <% if (isCampaignAdjustment) { %>
                                                        <!-- Campaign Level Adjustment -->
                                                        <div class="campaign-adjustment-card">
                                                            <div class="campaign-info-grid">
                                                                <div class="info-item">
                                                                    <span class="info-label"><i class="fas fa-tag"></i> Campaign</span>
                                                                    <span class="info-value"><%= campaign.name || 'N/A' %></span>
                                                                </div>
                                                                <div class="info-item">
                                                                    <span class="info-label"><i class="fas fa-hashtag"></i> Campaign ID</span>
                                                                    <span class="info-value monospace"><%= log.campaignId || 'N/A' %></span>
                                                                </div>
                                                                <% if (adj.action === 'INCREASE_BUDGET' || adj.action === 'DECREASE_BUDGET') { 
                                                                    const currentBudget = parseFloat(campaign.budget.budget) || 0;
                                                                    const newBudget = adj.change ? currentBudget * (1 + adj.change / 100) : currentBudget;
                                                                %>
                                                                    <div class="info-item">
                                                                        <span class="info-label"><i class="fas fa-wallet"></i> Current Budget</span>
                                                                        <span class="info-value budget-value">$<%= currentBudget.toFixed(2) %></span>
                                                                    </div>
                                                                    <div class="info-item">
                                                                        <span class="info-label"><i class="fas fa-wallet"></i> New Budget</span>
                                                                        <span class="info-value budget-value <%= newBudget > currentBudget ? 'increase' : 'decrease' %>">
                                                                            $<%= newBudget.toFixed(2) %>
                                                                        </span>
                                                                    </div>
                                                                <% } %>
                                                                <div class="info-item">
                                                                    <span class="info-label"><i class="fas fa-info-circle"></i> Campaign State</span>
                                                                    <span class="info-value">
                                                                        <span class="status-badge <%= campaign.state ? campaign.state.toLowerCase() : '' %>">
                                                                            <%= campaign.state || 'N/A' %>
                                                                        </span>
                                                                    </span>
                                                                </div>
                                                                <div class="info-item">
                                                                    <span class="info-label"><i class="fas fa-crosshairs"></i> Targeting Type</span>
                                                                    <span class="info-value"><%= campaign.targetingType || 'N/A' %></span>
                                                                </div>
                                                            </div>
                                                            <% if (adj.action === 'PAUSE_CAMPAIGN') { %>
                                                                <div class="action-note warning">
                                                                    <i class="fas fa-pause-circle"></i>
                                                                    Campaign will be paused due to poor performance or budget constraints.
                                                                </div>
                                                            <% } else if (adj.action === 'RESUME_CAMPAIGN') { %>
                                                                <div class="action-note success">
                                                                    <i class="fas fa-play-circle"></i>
                                                                    Campaign will be resumed as performance has improved.
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    <% } else if (entities.length > 0) { %>
                                                        <div class="table-responsive">
                                                            <table class="adjustments-detail-table">
                                                                <thead>
                                                                    <tr>
                                                                        <% if (entityType === 'target') { %>
                                                                            <th>Target ID</th>
                                                                            <th>Expression</th>
                                                                            <th>Current Bid</th>
                                                                            <th>New Bid</th>
                                                                        <% } else if (entityType === 'keyword') { %>
                                                                            <th>Keyword</th>
                                                                            <th>Match Type</th>
                                                                            <th>Current Bid</th>
                                                                            <th>New Bid</th>
                                                                        <% } else if (entityType === 'search-term') { %>
                                                                            <th>Search Term</th>
                                                                            <th>Impressions</th>
                                                                            <th>Clicks</th>
                                                                            <th>Cost</th>
                                                                            <th>Sales</th>
                                                                        <% } %>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <% entities.forEach(entity => { %>
                                                                        <tr>
                                                                            <% if (entityType === 'target') { 
                                                                                const currentBid = entity.bid || 0;
                                                                                const newBid = adj.change ? currentBid * (1 + adj.change / 100) : currentBid;
                                                                            %>
                                                                                <td class="target-id"><%= entity.targetId || 'N/A' %></td>
                                                                                <td class="target-expression">
                                                                                    <% if (entity.expression && entity.expression.length > 0) { %>
                                                                                        <% entity.expression.forEach((expr, i) => { %>
                                                                                            <span class="expr-item"><%= expr.type %>: <%= expr.value %></span><% if (i < entity.expression.length - 1) { %>, <% } %>
                                                                                        <% }); %>
                                                                                    <% } else if (entity.resolvedExpression && entity.resolvedExpression.length > 0) { %>
                                                                                        <% entity.resolvedExpression.forEach((expr, i) => { %>
                                                                                            <span class="expr-item"><%= expr.type %>: <%= expr.value %></span><% if (i < entity.resolvedExpression.length - 1) { %>, <% } %>
                                                                                        <% }); %>
                                                                                    <% } else { %>
                                                                                        <span class="text-muted">-</span>
                                                                                    <% } %>
                                                                                </td>
                                                                                <td class="bid-value current">$<%= currentBid.toFixed(2) %></td>
                                                                                <td class="bid-value new">
                                                                                    <span class="<%= newBid > currentBid ? 'increase' : newBid < currentBid ? 'decrease' : '' %>">
                                                                                        $<%= newBid.toFixed(2) %>
                                                                                    </span>
                                                                                </td>
                                                                            <% } else if (entityType === 'keyword') {
                                                                                const currentBid = parseFloat(entity.bid) || 0;
                                                                                const newBid = adj.change ? currentBid * (1 + adj.change / 100) : currentBid;
                                                                            %>
                                                                                <td class="keyword-text"><%= entity.keywordText || 'N/A' %></td>
                                                                                <td>
                                                                                    <span class="match-type-badge <%= entity.matchType ? entity.matchType.toLowerCase() : '' %>">
                                                                                        <%= entity.matchType || '-' %>
                                                                                    </span>
                                                                                </td>
                                                                                <td class="bid-value current">$<%= currentBid.toFixed(2) %></td>
                                                                                <td class="bid-value new">
                                                                                    <span class="<%= newBid > currentBid ? 'increase' : newBid < currentBid ? 'decrease' : '' %>">
                                                                                        $<%= newBid.toFixed(2) %>
                                                                                    </span>
                                                                                </td>
                                                                            <% } else if (entityType === 'search-term') { %>
                                                                                <td class="search-term-text">"<%= entity.searchTerm || entity.term || 'N/A' %>"</td>
                                                                                <td><%= entity.impressions || 0 %></td>
                                                                                <td><%= entity.clicks || 0 %></td>
                                                                                <td class="cost-value">$<%= (entity.cost || 0).toFixed(2) %></td>
                                                                                <td class="sales-value">$<%= (entity.sales || entity.sales7d || 0).toFixed(2) %></td>
                                                                            <% } %>
                                                                        </tr>
                                                                    <% }); %>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    <% } else { %>
                                                        <p class="no-entities">No <%= adj.target || 'entities' %> affected by this adjustment.</p>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        <% } %>

                                        <% if (log.targetings && log.targetings.length > 0 && (!log.adjustments || log.adjustments.length === 0)) { %>
                                            <div class="targets-section">
                                                <h4><i class="fas fa-bullseye"></i> Targetings</h4>
                                                <div class="table-responsive">
                                                    <table class="adjustments-detail-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Target ID</th>
                                                                <th>Expression</th>
                                                                <th>Bid</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% log.targetings.forEach(t => { %>
                                                                <tr>
                                                                    <td class="target-id"><%= t.targetId || t._id || 'N/A' %></td>
                                                                    <td class="target-expression"><%= t.expression || t.targeting || '-' %></td>
                                                                    <td class="bid-value">
                                                                        <% if (t.bid !== undefined) { %>
                                                                            $<%= t.bid.toFixed(2) %>
                                                                        <% } else { %>
                                                                            <span class="text-muted">-</span>
                                                                        <% } %>
                                                                    </td>
                                                                </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        <% } %>

                                        <% if (log.keywords && log.keywords.length > 0 && (!log.adjustments || log.adjustments.length === 0)) { %>
                                            <div class="keywords-section">
                                                <h4><i class="fas fa-key"></i> Keywords</h4>
                                                <div class="table-responsive">
                                                    <table class="adjustments-detail-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Keyword</th>
                                                                <th>Match Type</th>
                                                                <th>Bid</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% log.keywords.forEach(k => { %>
                                                                <tr>
                                                                    <td class="keyword-text"><%= k.keywordText || k.text || 'N/A' %></td>
                                                                    <td>
                                                                        <span class="match-type-badge <%= k.matchType ? k.matchType.toLowerCase() : '' %>">
                                                                            <%= k.matchType || '-' %>
                                                                        </span>
                                                                    </td>
                                                                    <td class="bid-value">
                                                                        <% if (k.bid !== undefined) { %>
                                                                            $<%= k.bid.toFixed(2) %>
                                                                        <% } else { %>
                                                                            <span class="text-muted">-</span>
                                                                        <% } %>
                                                                    </td>
                                                                </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        <% } %>

                                        <% if (log.searchTerms && log.searchTerms.length > 0 && (!log.adjustments || log.adjustments.length === 0)) { %>
                                            <div class="search-terms-section">
                                                <h4><i class="fas fa-search"></i> Search Terms</h4>
                                                <div class="table-responsive">
                                                    <table class="adjustments-detail-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Search Term</th>
                                                                <th>Impressions</th>
                                                                <th>Clicks</th>
                                                                <th>Cost</th>
                                                                <th>Sales</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% log.searchTerms.forEach(st => { %>
                                                                <tr>
                                                                    <td class="search-term-text">"<%= st.searchTerm || st.term || 'N/A' %>"</td>
                                                                    <td><%= st.impressions || 0 %></td>
                                                                    <td><%= st.clicks || 0 %></td>
                                                                    <td class="cost-value">$<%= (st.cost || 0).toFixed(2) %></td>
                                                                    <td class="sales-value">$<%= (st.sales || st.sales7d || 0).toFixed(2) %></td>
                                                                </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="no-data">No optimization history yet for this campaign.</p>
                <% } %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h2>Campaign Not Found</h2>
                <p>The campaign you're looking for doesn't exist.</p>
                <a href="/campaigns" class="btn">Back to Campaigns</a>
            </div>
        <% } %>
    </main>
    
    <%- include('partials/footer') %>

