<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Profile - Amazon Bid Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .select-profile-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: #ffffff;
            padding: 40px 20px;
        }

        /* Animated background elements */
        .bg-decoration {
            position: absolute;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 0;
        }

        .floating-circle {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(17, 29, 51, 0.08) 0%, rgba(13, 23, 42, 0.12) 100%);
            animation: float 20s infinite ease-in-out;
        }

        .floating-circle:nth-child(1) {
            width: 400px;
            height: 400px;
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .floating-circle:nth-child(2) {
            width: 300px;
            height: 300px;
            bottom: -50px;
            left: -50px;
            animation-delay: -5s;
        }

        .floating-circle:nth-child(3) {
            width: 200px;
            height: 200px;
            top: 50%;
            left: 10%;
            animation-delay: -10s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(180deg); }
        }

        /* Grid pattern overlay */
        .grid-pattern {
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(17, 29, 51, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(17, 29, 51, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 1;
        }

        .select-profile-box {
            background: #ffffff;
            padding: 3rem;
            border-radius: 24px;
            box-shadow: 
                0 0 0 1px rgba(17, 29, 51, 0.1),
                0 20px 60px rgba(17, 29, 51, 0.15),
                0 0 100px rgba(17, 29, 51, 0.08);
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
            position: relative;
            z-index: 10;
            border: 1px solid rgba(17, 29, 51, 0.15);
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .header-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, #111d33 0%, #1a2a4d 100%);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            box-shadow: 
                0 0 0 1px rgba(17, 29, 51, 0.3),
                0 10px 40px rgba(17, 29, 51, 0.2),
                0 0 60px rgba(17, 29, 51, 0.15);
            animation: pulse-glow 3s infinite ease-in-out;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 0 1px rgba(17, 29, 51, 0.3), 0 10px 40px rgba(17, 29, 51, 0.2), 0 0 60px rgba(17, 29, 51, 0.15); }
            50% { box-shadow: 0 0 0 1px rgba(17, 29, 51, 0.4), 0 15px 50px rgba(17, 29, 51, 0.3), 0 0 80px rgba(17, 29, 51, 0.2); }
        }

        .header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            color: #111d33;
            text-shadow: 0 0 30px rgba(17, 29, 51, 0.2);
        }

        .header p {
            color: #1a2a4d;
            font-size: 1.1rem;
            font-weight: 500;
            text-shadow: 0 0 20px rgba(17, 29, 51, 0.15);
        }

        .profiles-list {
            margin-bottom: 2rem;
        }

        .list-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr auto;
            padding: 14px 20px;
            background: linear-gradient(135deg, #111d33 0%, #1a2a4d 100%);
            color: white;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 12px 12px 0 0;
        }

        .profile-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr auto;
            padding: 16px 20px;
            align-items: center;
            border-bottom: 1px solid #f1f5f9;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
        }

        .profile-row:last-child {
            border-bottom: none;
            border-radius: 0 0 12px 12px;
        }

        .profile-row:hover {
            background: #f8fafc;
        }

        .profile-row.selected {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            border-left: 4px solid #111d33;
        }
        .col-account {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .profile-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #111d33 0%, #1a2a4d 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .profile-row.selected .profile-icon {
            background: linear-gradient(135deg, #0d172a 0%, #1e293b 100%);
            box-shadow: 0 4px 12px rgba(17, 29, 51, 0.3);
        }

        .account-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .account-name {
            font-weight: 600;
            color: #111d33;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .account-id {
            font-size: 0.75rem;
            color: #64748b;
            font-family: monospace;
        }

        .col-type, .col-country, .col-currency, .col-timezone {
            color: #475569;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
        }

        .type-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .type-badge.seller {
            background: #dbeafe;
            color: #1e40af;
        }

        .type-badge.vendor {
            background: #dcfce7;
            color: #166534;
        }

        .type-badge.agency {
            background: #fef3c7;
            color: #92400e;
        }

        .col-select {
            display: flex;
            justify-content: flex-end;
        }

        .select-radio {
            width: 24px;
            height: 24px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .profile-row.selected .select-radio {
            border-color: #111d33;
            background: #111d33;
        }

        .select-radio::after {
            content: '✓';
            color: white;
            font-size: 14px;
            font-weight: bold;
            opacity: 0;
        }

        .profile-row.selected .select-radio::after {
            opacity: 1;
        }

        .actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn-select {
            background: linear-gradient(135deg, #111d33 0%, #1a2a4d 100%);
            color: white;
            padding: 1rem 3rem;
            border-radius: 12px;
            border: none;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(17, 29, 51, 0.3), 0 0 30px rgba(17, 29, 51, 0.2);
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
        }

        .btn-select:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(17, 29, 51, 0.4), 0 0 40px rgba(17, 29, 51, 0.3);
        }

        .btn-select:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-logout {
            background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
            color: #111d33;
            padding: 1rem 2rem;
            border-radius: 12px;
            border: 2px solid rgba(17, 29, 51, 0.3);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            box-shadow: 0 4px 15px rgba(17, 29, 51, 0.1);
        }

        .btn-logout:hover {
            background: linear-gradient(135deg, #111d33 0%, #0d172a 100%);
            color: white;
            border-color: #111d33;
            box-shadow: 0 8px 25px rgba(17, 29, 51, 0.3);
        }

        .alert {
            padding: 1rem 1.25rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            text-align: center;
            font-weight: 500;
        }

        .alert-error {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            color: #991b1b;
            border: 1px solid #fecaca;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.1);
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #111d33;
        }

        .empty-state-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            filter: drop-shadow(0 0 10px rgba(17, 29, 51, 0.3));
        }

        .empty-state h3 {
            color: #0d172a;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            text-shadow: 0 0 10px rgba(17, 29, 51, 0.2);
        }

        .empty-state p {
            color: #64748b;
        }

        /* Decorative particles */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: #111d33;
            border-radius: 50%;
            opacity: 0.3;
            animation: particle-float 15s infinite ease-in-out;
        }

        @keyframes particle-float {
            0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
            50% { transform: translateY(-100px) translateX(50px); opacity: 0.6; }
        }

        @media (max-width: 900px) {
            .select-profile-box {
                padding: 2rem;
            }

            .list-header {
                display: none;
            }

            .profile-row {
                grid-template-columns: 1fr;
                gap: 12px;
                padding: 20px;
            }

            .col-account {
                grid-column: 1;
            }

            .col-type, .col-country, .col-currency, .col-timezone {
                grid-column: 1;
                justify-content: flex-start;
            }

            .col-select {
                grid-column: 1;
                justify-content: flex-start;
                padding-top: 12px;
                border-top: 1px solid #f1f5f9;
            }
        }

        @media (max-width: 640px) {
            .select-profile-box {
                padding: 1.5rem;
            }

            .header h1 {
                font-size: 1.5rem;
            }

            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="select-profile-container">
        <div class="bg-decoration">
            <div class="floating-circle"></div>
            <div class="floating-circle"></div>
            <div class="floating-circle"></div>
            <div class="grid-pattern"></div>
            <div class="particle" style="top: 20%; left: 15%; animation-delay: 0s;"></div>
            <div class="particle" style="top: 60%; left: 80%; animation-delay: -3s;"></div>
            <div class="particle" style="top: 80%; left: 30%; animation-delay: -6s;"></div>
            <div class="particle" style="top: 30%; left: 70%; animation-delay: -9s;"></div>
        </div>

        <div class="select-profile-box">
            <div class="header">
                <div class="header-icon">🎯</div>
                <h1>Select Your Profile</h1>
                <p>Choose an Amazon Advertising profile to manage</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error">
                    <% if (error === 'profile_not_found') { %>
                        ❌ Profile not found. Please select a valid profile.
                    <% } else { %>
                        ❌ An error occurred. Please try again.
                    <% } %>
                </div>
            <% } %>

            <% if (profiles && profiles.length > 0) { %>
                <form action="/select-profile" method="POST" id="profileForm">
                    <div class="profiles-list">
                        <div class="list-header">
                            <div class="col-account">Account</div>
                            <div class="col-type">Type</div>
                            <div class="col-country">Country</div>
                            <div class="col-currency">Currency</div>
                            <div class="col-timezone">Timezone</div>
                            <div class="col-select"></div>
                        </div>
                        <% profiles.forEach(profile => { %>
                            <div class="profile-row <%= selectedProfile && selectedProfile.profileId === profile.profileId ? 'selected' : '' %>" 
                                 data-profile-id="<%= profile.profileId %>"
                                 onclick="selectRow(this)">
                                <div class="col-account">
                                    <div class="profile-icon">
                                        <%= profile.accountInfo.type === 'seller' ? '🏪' : profile.accountInfo.type === 'vendor' ? '🏢' : '👥' %>
                                    </div>
                                    <div class="account-info">
                                        <span class="account-name"><%= profile.accountInfo.name %></span>
                                        <span class="account-id">ID: <%= profile.profileId %></span>
                                    </div>
                                </div>
                                <div class="col-type">
                                    <span class="type-badge <%= profile.accountInfo.type %>"><%= profile.accountInfo.type.toUpperCase() %></span>
                                </div>
                                <div class="col-country"><%= profile.countryCode %></div>
                                <div class="col-currency"><%= profile.currencyCode %></div>
                                <div class="col-timezone"><%= profile.timezone %></div>
                                <div class="col-select">
                                    <div class="select-radio"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <input type="hidden" name="profileId" id="selectedProfileId" value="<%= selectedProfile ? selectedProfile.profileId : '' %>">

                    <div class="actions">
                        <button type="submit" class="btn-select" id="continueBtn" <%= !selectedProfile ? 'disabled' : '' %>>
                            Continue to Dashboard →
                        </button>
                        <a href="/auth/logout" class="btn-logout">Logout</a>
                    </div>
                </form>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <h3>No Profiles Available</h3>
                    <p>No Amazon Advertising profiles found for your account.</p>
                    <div class="actions">
                        <a href="/auth/logout" class="btn-logout">Logout</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function selectRow(row) {
            // Remove selected class from all rows
            document.querySelectorAll('.profile-row').forEach(r => r.classList.remove('selected'));
            
            // Add selected class to clicked row
            row.classList.add('selected');
            
            // Update hidden input
            const profileId = row.getAttribute('data-profile-id');
            document.getElementById('selectedProfileId').value = profileId;
            
            // Enable continue button
            document.getElementById('continueBtn').disabled = false;
        }

        // Auto-select if only one profile
        <% if (profiles && profiles.length === 1) { %>
            window.onload = function() {
                const row = document.querySelector('.profile-row');
                if (row) {
                    selectRow(row);
                }
            };
        <% } %>
    </script>
</body>
</html>
