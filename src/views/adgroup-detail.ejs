<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ad Group <%= adGroup.adGroupId %> - Product Ads</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { selectedProfile, profiles, currentPage: 'campaigns' }) %>
    
    <main class="container">
        <a href="/campaigns/<%= campaignId %>" class="back-link-compact">← Back</a>
        
        <div class="campaign-header-card">
            <div class="info-item">
                <span class="info-label">Ad Group ID:</span>
                <span class="info-value"><%= adGroup.adGroupId %></span>|
                 <span class="info-label">Campaign ID:</span>
                <span class="info-value"><%=campaignId %></span>|
                 <span class="info-label">Ad Group Name:</span>
                <span class="info-value"><%= adGroup.name %></span>
            </div>
        </div>
        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <a href="/campaigns/<%= campaignId %>/adgroups/<%= adGroup.adGroupId %>?tab=ads" class="tab <%= selectedTab === 'ads' ? 'active' : '' %>">Ads</a>
            <a href="/campaigns/<%= campaignId %>/adgroups/<%= adGroup.adGroupId %>?tab=keywords" class="tab <%= selectedTab === 'keywords' ? 'active' : '' %>">Keywords</a>
            <a href="/campaigns/<%= campaignId %>/adgroups/<%= adGroup.adGroupId %>?tab=targeting" class="tab <%= selectedTab === 'targeting' ? 'active' : '' %>">Targeting</a>
            <a href="/campaigns/<%= campaignId %>/adgroups/<%= adGroup.adGroupId %>?tab=searchterms" class="tab <%= selectedTab === 'searchterms' ? 'active' : '' %>">Search Terms</a>
        </div>

        <!-- Ads Tab Content -->
        <% if (selectedTab === 'ads') { %>
        <div class="section white-bg">
            <div class="section-header">
                <div>
                    <h3 class="glow-text-green"><i class="fas fa-box"></i> Product Ads</h3>
                    <p class="subtitle"><i class="fas fa-info-circle"></i> Products advertised in this ad group</p>
                </div>
            </div>
            <% if (productAds && productAds.length > 0) { %>
                <div class="table-responsive">
                    <table class="product-ads-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Title / Ad ID</th>
                                <th>ASIN / SKU</th>
                                <th>Brand</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% productAds.forEach(ad => { 
                                const product = products[ad.asin] || {};
                            %>
                                <tr>
                                    <td class="img-cell">
                                        <% if (product.imageUrl) { %>
                                            <img src="<%= product.imageUrl %>" alt="<%= product.title || ad.asin %>" class="product-thumb">
                                        <% } else { %>
                                            <div class="product-thumb-placeholder">
                                                <i class="fas fa-image"></i>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="title-cell">
                                            <div class="product-title-text" title="<%= product.title || 'Unknown Product' %>">
                                                <%= product.title || 'Unknown Product' %>
                                            </div>
                                            <div class="product-ad-id"><%= ad.adId %></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="asin-sku-cell">
                                            <div class="asin-text"><%= ad.asin || 'N/A' %></div>
                                            <div class="sku-text"><%= product.sku || ad.sku || 'N/A' %></div>
                                        </div>
                                    </td>
                                    <td><%= product.brand || '-' %></td>
                                    <td>
                                        <% if (product.priceToPay) { %>
                                            <span class="price-text"><%= product.priceToPay.currency %> <%= product.priceToPay.amount.toLocaleString() %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (product.availability === 'IN_STOCK') { %>
                                            <span class="stock-badge in-stock"><i class="fas fa-check"></i> In Stock</span>
                                        <% } else if (product.availability) { %>
                                            <span class="stock-badge out-of-stock"><%= product.availability %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= ad.state.toLowerCase() %>">
                                            <%= ad.state %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No product ads found for this ad group.</p>
                </div>
            <% } %>
        </div>
        <% } %>

        <!-- Keywords Tab Content -->
        <% if (selectedTab === 'keywords') { %>
        <% 
            const reportMap = {};
            let latestReportDate = null;
            if (typeof keywordReports !== 'undefined' && keywordReports) {
                keywordReports.forEach(r => {
                    reportMap[r._id.toString()] = r.latestReport;
                    if (r.latestReport && (!latestReportDate || r.latestReport.date > latestReportDate)) {
                        latestReportDate = r.latestReport.date;
                    }
                });
            }
        %>
        <div class="section white-bg">
            <div class="section-header">
                <div>
                    <h3 class="glow-text-green"><i class="fas fa-key"></i> Keywords Analysis</h3>
                    <% if (latestReportDate) { %>
                        <p class="subtitle"><i class="fas fa-clock"></i> Latest report data from: <strong><%= latestReportDate %></strong></p>
                    <% } else { %>
                        <p class="subtitle"><i class="fas fa-exclamation-triangle"></i> No report data available yet</p>
                    <% } %>
                </div>
                <div class="keyword-filters">
                    <div class="filter-group">
                        <label for="typeFilter">
                            <i class="fas fa-filter"></i>
                            Type Filter
                        </label>
                        <select id="typeFilter" class="filter-select" onchange="filterKeywords()">
                            <option value="all">All Keywords</option>
                            <option value="positive">Positive Keywords</option>
                            <option value="negative">Negative Keywords</option>
                        </select>
                    </div>
                    <div class="filter-stats">
                        <span id="keywordCount" class="count-badge">Total: <%= keywords.length %></span>
                        <span id="positiveCount" class="count-badge positive">Positive: <span class="count">0</span></span>
                        <span id="negativeCount" class="count-badge negative">Negative: <span class="count">0</span></span>
                    </div>
                </div>
            </div>
            
            <% if (keywords && keywords.length > 0) { %>
                <div class="table-responsive">
                    <table id="keywordsTable" class="keyword-table">
                        <thead>
                            <tr>
                                <th>Keyword Text</th>
                                <th>Match Type</th>
                                <th>Bid</th>
                                <th>Impressions</th>
                                <th>Clicks</th>
                                <th>Spend</th>
                                <th>Sales (7d)</th>
                                <th>ACOS</th>
                                <th>State</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% keywords.forEach(keyword => { %>
                                <% const report = reportMap[keyword.keywordId]; %>
                                <tr class="keyword-row" data-type="<%= keyword.type === 1 ? 'positive' : 'negative' %>">
                                    <td>
                                        <div class="keyword-text-container">
                                            <strong><%= keyword.keywordText || 'N/A' %></strong>
                                            <span class="keyword-id-sub"><%= keyword.keywordId %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="match-type-badge <%= keyword.matchType.toLowerCase() %>">
                                            <%= keyword.matchType %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (keyword.type === 1 && keyword.bid) { %>
                                            <span class="bid-amount glow-text-green">$<%= parseFloat(keyword.bid).toFixed(2) %></span>
                                        <% } else if (keyword.type === 1) { %>
                                            <span class="text-muted">N/A</span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="metric-val"><%= report ? (report.impressions || 0).toLocaleString() : '0' %></span>
                                    </td>
                                    <td>
                                        <span class="metric-val"><%= report ? (report.clicks || 0).toLocaleString() : '0' %></span>
                                    </td>
                                    <td>
                                        <span class="metric-val">$<%= report ? (report.cost || report.spend || 0).toFixed(2) : '0.00' %></span>
                                    </td>
                                    <td>
                                        <span class="metric-val sales-glow">$<%= report ? (report.sales7d || 0).toFixed(2) : '0.00' %></span>
                                    </td>
                                    <td>
                                        <% if (report && report.sales7d > 0) { %>
                                            <% const acos = ((report.cost || report.spend || 0) / report.sales7d * 100).toFixed(1); %>
                                            <span class="acos-badge <%= acos < 25 ? 'low' : (acos < 50 ? 'medium' : 'high') %>">
                                                <%= acos %>%
                                            </span>
                                        <% } else if (report && (report.cost || report.spend) > 0) { %>
                                            <span class="acos-badge high">100%+</span>
                                        <% } else { %>
                                            <span class="text-muted">N/A</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= keyword.state.toLowerCase() %>">
                                            <%= keyword.state %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <% if (keyword.type === 1) { %>
                                                <button class="btn-icon" title="Edit Bid" onclick="editKeyword('<%= keyword.keywordId %>', '<%= keyword.bid %>')">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon" title="View History" onclick="viewKeywordHistory('<%= keyword.keywordId %>')">
                                                    <i class="fas fa-history"></i>
                                                </button>
                                            <% } else { %>
                                                <button class="btn-icon btn-danger" title="Remove" onclick="removeNegativeKeyword('<%= keyword.keywordId %>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No keywords found for this ad group.</p>
                    <p>Keywords will appear here after they are synced from Amazon.</p>
                    <!-- <div class="type-info">
                        <p><strong>Positive Keywords (Type = 1)</strong>: Keywords you bid on</p>
                        <p><strong>Negative Keywords (Type = -1)</strong>: Keywords to exclude</p>
                    </div> -->
                </div>
            <% } %>
        </div>
        <% } %>

        <!-- Targeting Tab Content -->
        <% if (selectedTab === 'targeting') { %>
        <div class="section">
            <div class="section-header">
                <h3>Targeting</h3>
                <div class="targeting-filters">
                    <div class="filter-group">
                        <label for="targetTypeFilter">
                            <i class="fas fa-filter"></i>
                            Type Filter
                        </label>
                        <select id="targetTypeFilter" class="filter-select" onchange="filterTargets()">
                            <option value="all">All Targets</option>
                            <option value="positive">Positive Targets</option>
                            <option value="negative">Negative Targets</option>
                        </select>
                    </div>
                    <div class="targeting-stats">
                        <span id="targetCount" class="count-badge">Total: <%= targets.length %></span>
                        <span id="positiveTargetCount" class="count-badge positive">Positive: <span class="count">0</span></span>
                        <span id="negativeTargetCount" class="count-badge negative">Negative: <span class="count">0</span></span>
                    </div>
                </div>
            </div>
            
            <% if (targets && targets.length > 0) { %>
                <% 
                    // Create a map of targeting reports by targetId
                    const targetingReportMap = {};
                    if (targetingReports && targetingReports.length > 0) {
                        targetingReports.forEach(report => {
                            targetingReportMap[report.targetId] = report;
                        });
                    }
                %>
                <div class="table-responsive">
                    <table class="targeting-table">
                        <thead>
                            <tr>
                                <th>Target</th>
                                <th>Type</th>
                                <th>State</th>
                                <th>Bid</th>
                                <th>Impr</th>
                                <th>Clicks</th>
                                <th>Cost</th>
                                <th>Sales 7d</th>
                                <th>Sales 14d</th>
                                <th>ACOS</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% targets.forEach(target => { 
                                const report = targetingReportMap[target.targetId];
                            %>
                                <tr class="target-row" 
                                    data-type="<%= target.type === 1 ? 'positive' : 'negative' %>"
                                    data-expression-type="<%= target.expressionType ? target.expressionType.toLowerCase() : 'unknown' %>">
                                    <td>
                                        <div class="target-combined">
                                            <div class="target-id-top" title="<%= target.targetId %>"><%= target.targetId %></div>
                                            <div class="target-expression-bottom">
                                                <% if (target.expression && target.expression.length > 0) { %>
                                                    <% target.expression.forEach(expr => { %>
                                                        <span class="expr-text"><%= expr.type %><% if (expr.value) { %>: <%= expr.value %><% } %></span>
                                                    <% }); %>
                                                <% } else if (target.resolvedExpression && target.resolvedExpression.length > 0) { %>
                                                    <% target.resolvedExpression.forEach(expr => { %>
                                                        <span class="expr-text"><%= expr.type %><% if (expr.value) { %>: <%= expr.value %><% } %></span>
                                                    <% }); %>
                                                <% } else { %>
                                                    <span class="text-muted">-</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="type-badge <%= target.type === 1 ? 'positive' : 'negative' %>">
                                            <%= target.type === 1 ? 'Positive' : 'Negative' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= target.state.toLowerCase() %>">
                                            <%= target.state %>
                                        </span>
                                    </td>
                                    <td class="metric-cell">
                                        <% if (target.type === 1 && target.bid) { %>
                                            <span class="bid-amount">$<%= target.bid.toFixed(2) %></span>
                                        <% } else if (target.type === 1) { %>
                                            <span class="text-muted">N/A</span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td class="metric-cell">
                                        <%= report ? report.impressions.toLocaleString() : '-' %>
                                    </td>
                                    <td class="metric-cell">
                                        <%= report ? report.clicks.toLocaleString() : '-' %>
                                    </td>
                                    <td class="metric-cell cost">
                                        <%= report ? '₹' + report.cost.toLocaleString() : '-' %>
                                    </td>
                                    <td class="metric-cell sales">
                                        <%= report ? '₹' + report.sales7d.toLocaleString() : '-' %>
                                    </td>
                                    <td class="metric-cell sales">
                                        <%= report ? '₹' + report.sales14d.toLocaleString() : '-' %>
                                    </td>
                                    <td class="metric-cell acos">
                                        <% if (report && report.sales14d > 0) { 
                                            const acos = (report.cost / report.sales14d * 100).toFixed(2);
                                        %>
                                            <span class="acos-badge <%= acos < 20 ? 'good' : acos < 40 ? 'medium' : 'bad' %>">
                                                <%= acos %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (target.type === 1) { %>
                                            <button class="btn-small" onclick="editTargetBid('<%= target.targetId %>', '<%= target.bid || 0 %>')">
                                                Edit Bid
                                            </button>
                                        <% } else { %>
                                            <button class="btn-small btn-secondary" onclick="removeNegativeTarget('<%= target.targetId %>')">
                                                Remove
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No targeting found for this ad group.</p>
                    <p>Targeting will appear here after they are synced from Amazon.</p>
                    <div class="type-info">
                        <p><strong>Auto Targeting</strong>: Amazon automatically targets relevant searches</p>
                        <p><strong>Manual Targeting</strong>: You specify exact targeting criteria</p>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>

        <!-- Search Terms Tab Content -->
        <% if (selectedTab === 'searchterms') { %>
        <div class="section white-bg">
            <div class="section-header">
                <div>
                    <h3 class="glow-text-green"><i class="fas fa-search"></i> Search Terms</h3>
                    <p class="subtitle"><i class="fas fa-info-circle"></i> Customer search terms that triggered your ads</p>
                </div>
            </div>
            <% if (searchTerms && searchTerms.length > 0) { %>
                <div class="table-responsive">
                    <table class="search-terms-table">
                        <thead>
                            <tr>
                                <th>Search Term</th>
                                <th>Keyword</th>
                                <th>Match Type</th>
                                <th>Impr</th>
                                <th>Clicks</th>
                                <th>Cost</th>
                                <th>Sales 7d</th>
                                <th>Sales 14d</th>
                                <th>ACOS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% searchTerms.forEach(term => { %>
                                <tr>
                                    <td class="search-term-cell">
                                        <span class="search-term-text">"<%= term.searchTerm %>"</span>
                                    </td>
                                    <td>
                                        <% if (term.keyword) { %>
                                            <span class="keyword-badge"><%= term.keyword %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="match-type-badge <%= term.matchType ? term.matchType.toLowerCase() : '' %>">
                                            <%= term.matchType || 'N/A' %>
                                        </span>
                                    </td>
                                    <td class="metric-cell">
                                        <%= term.impressions ? term.impressions.toLocaleString() : '0' %>
                                    </td>
                                    <td class="metric-cell">
                                        <%= term.clicks ? term.clicks.toLocaleString() : '0' %>
                                    </td>
                                    <td class="metric-cell cost">
                                        ₹<%= term.cost ? term.cost.toLocaleString() : '0' %>
                                    </td>
                                    <td class="metric-cell sales">
                                        ₹<%= term.sales7d ? term.sales7d.toLocaleString() : '0' %>
                                    </td>
                                    <td class="metric-cell sales">
                                        ₹<%= term.sales14d ? term.sales14d.toLocaleString() : '0' %>
                                    </td>
                                    <td class="metric-cell acos">
                                        <% const acos = term.sales14d > 0 ? (term.cost / term.sales14d * 100).toFixed(2) : '0.00'; %>
                                        <% if (acos > 0) { %>
                                            <span class="acos-badge <%= acos < 20 ? 'good' : acos < 40 ? 'medium' : 'bad' %>">
                                                <%= acos %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No search term data found for this ad group.</p>
                    <p>Search terms will appear here after they are synced from Amazon.</p>
                    <p class="type-info">Search terms are only available for auto campaigns or broad/phrase match keywords.</p>
                </div>
            <% } %>
        </div>
        <% } %>

        <!-- Negative Keywords Tab Content - REMOVED -->
        <!-- All keywords are now shown in the Keywords & Targeting tab with filtering -->
    </main>
    
    <style>
        .glow-text-green {
            color: #2e7d32;
            text-shadow: 0 0 8px rgba(46, 125, 50, 0.3);
            font-weight: 700;
        }
        .white-bg {
            background-color: #ffffff !important;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05) !important;
        }

        /* Product Ads Table */
        .product-ads-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .product-ads-table th {
            background: #f8fafc;
            padding: 0.75rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .product-ads-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }
        
        .product-ads-table tr:hover {
            background: #fafafa;
        }
        
        .img-cell {
            width: 60px;
        }
        
        .product-thumb {
            width: 50px;
            height: 50px;
            object-fit: contain;
            border-radius: 6px;
            background: #f8fafc;
        }
        
        .product-thumb-placeholder {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            border-radius: 6px;
            color: #cbd5e1;
        }

        /* Search Terms Table */
        .search-terms-table {
            width: 100%;
            border-collapse: collapse;
        }

        .search-terms-table th {
            background: #f8fafc;
            padding: 0.75rem 0.75rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
        }

        .search-terms-table td {
            padding: 0.75rem 0.75rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .search-terms-table tr:hover {
            background: #fafafa;
        }

        .search-term-cell {
            max-width: 250px;
        }

        .search-term-text {
            font-weight: 600;
            color: #1e293b;
            font-style: italic;
        }

        .keyword-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            background: #e0e7ff;
            color: #3730a3;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .match-type-badge {
            display: inline-block;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .match-type-badge.exact {
            background: #dcfce7;
            color: #166534;
        }

        .match-type-badge.phrase {
            background: #dbeafe;
            color: #1e40af;
        }

        .match-type-badge.broad {
            background: #fef3c7;
            color: #92400e;
        }

        .match-type-badge.targeting_expression {
            background: #f3e8ff;
            color: #7c3aed;
        }

        .match-type-badge.targeting_expression_predefined {
            background: #fce7f3;
            color: #be185d;
        }

        /* Targeting Table with Metrics */
        .targeting-table {
            width: 100%;
            border-collapse: collapse;
        }

        .targeting-table th {
            background: #f8fafc;
            padding: 0.75rem 0.5rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
        }

        .targeting-table td {
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

