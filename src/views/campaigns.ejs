<%- include('partials/header', { currentPage: 'campaigns', selectedProfile, profiles, title: 'Campaigns' }) %>

<div class="page-header">
    <h2>All Campaigns</h2>
    <div class="actions">
        <button onclick="syncCampaigns()" class="btn">🔄 Sync Now</button>
        <!-- <button onclick="adjustBids()" class="btn btn-primary">⚡ Adjust Bids Now</button> -->
    </div>
</div>

<!-- Filters -->
<div class="filters-section">
    <div class="filters-container">
        <form id="campaignFilters" class="filter-form">
            <div class="filter-inputs">
                <div class="filter-group search-group">
                    <label for="filterName">
                        <i class="fas fa-search"></i>
                        Search
                    </label>
                    <div class="input-wrapper">
                        <input 
                            type="text" 
                            id="filterName" 
                            name="name" 
                            placeholder="Search campaigns..." 
                            value="<%= filterName %>"
                            class="search-input"
                        >
                        <% if (filterName) { %>
                            <button type="button" class="clear-input" onclick="clearSearchInput()" title="Clear search">
                                <i class="fas fa-times"></i>
                            </button>
                        <% } %>
                    </div>
                </div>
                
                <div class="filter-group status-group">
                    <label for="filterStatus">
                        <i class="fas fa-toggle-on"></i>
                        Status
                    </label>
                    <div class="select-wrapper">
                        <select id="filterStatus" name="status" class="status-select">
                            <option value="">All Statuses</option>
                            <option value="enabled" <%= filterStatus === 'enabled' ? 'selected' : '' %>>
                                ✓ Enabled
                            </option>
                            <option value="paused" <%= filterStatus === 'paused' ? 'selected' : '' %>>
                                ⏸ Paused
                            </option>
                            <option value="archived" <%= filterStatus === 'archived' ? 'selected' : '' %>>
                                📦 Archived
                            </option>
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>
                </div>
                
                <div class="filter-group targeting-group">
                    <label for="filterTargeting">
                        <i class="fas fa-bullseye"></i>
                        Targeting
                    </label>
                    <div class="select-wrapper">
                        <select id="filterTargeting" name="targeting" class="status-select">
                            <option value="">All Types</option>
                            <option value="AUTO" <%= filterTargeting === 'AUTO' ? 'selected' : '' %>>
                                🤖 Auto
                            </option>
                            <option value="MANUAL" <%= filterTargeting === 'MANUAL' ? 'selected' : '' %>>
                                🎯 Manual
                            </option>
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>
                </div>
                
                <div class="filter-actions">
                    <button type="submit" class="btn-apply">
                        <i class="fas fa-check"></i>
                        Apply
                    </button>
                    <button type="button" class="btn-clear" onclick="clearFilters()">
                        <i class="fas fa-redo"></i>
                        Reset
                    </button>
                </div>
            </div>
            
            <% if (filterName || filterStatus || filterTargeting) { %>
                <div class="active-filters">
                    <span class="active-filters-label">Active:</span>
                    <% if (filterName) { %>
                        <span class="filter-tag">
                            <i class="fas fa-search"></i>
                            "<%= filterName %>"
                            <button type="button" onclick="clearFilter('name')" class="remove-filter">×</button>
                        </span>
                    <% } %>
                    <% if (filterStatus) { %>
                        <span class="filter-tag">
                            <i class="fas fa-toggle-on"></i>
                            <%= filterStatus %>
                            <button type="button" onclick="clearFilter('status')" class="remove-filter">×</button>
                        </span>
                    <% } %>
                    <% if (filterTargeting) { %>
                        <span class="filter-tag">
                            <i class="fas fa-bullseye"></i>
                            <%= filterTargeting %>
                            <button type="button" onclick="clearFilter('targeting')" class="remove-filter">×</button>
                        </span>
                    <% } %>
                </div>
            <% } %>
        </form>
    </div>
</div>

        <div class="table-responsive">
            <table class="campaign-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Campaign</th>
                        <th>Targeting</th>
                        <th>Budget</th>
                        <th>Impr</th>
                        <th>Clicks</th>
                        <th>Cost</th>
                        <th>Sales</th>
                        <th>ACOS</th>
                        <th>ROAS</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% campaigns.forEach((campaign,i) => { %>
                        <tr>
                            <td><%= i+1 %></td>
                            <td>
                                <div class="campaign-info">
                                    <div class="campaign-name"><%= campaign.name %></div>
                                    <div class="campaign-id">ID: <%= campaign.campaignId %></div>
                                </div>
                            </td>
                            <td>
                                <span class="targeting-badge <%= campaign.targetingType ? campaign.targetingType.toLowerCase() : 'unknown' %>">
                                    <% if (campaign.targetingType === 'AUTO') { %>
                                        🤖 Auto
                                    <% } else if (campaign.targetingType === 'MANUAL') { %>
                                        🎯 Manual
                                    <% } else { %>
                                        ❓ Unknown
                                    <% } %>
                                </span>
                            </td>
                            <td>₹<%= campaign.budget.budget %> <%= campaign.budget.budgetType %></td>
                            <td class="metric-cell">
                                <%= campaign.metrics ? campaign.metrics.impressions.toLocaleString() : '-' %>
                            </td>
                            <td class="metric-cell">
                                <%= campaign.metrics ? campaign.metrics.clicks.toLocaleString() : '-' %>
                            </td>
                            <td class="metric-cell cost">
                                <%= campaign.metrics ? '₹' + campaign.metrics.cost.toLocaleString() : '-' %>
                            </td>
                            <td class="metric-cell sales">
                                <%= campaign.metrics ? '₹' + campaign.metrics.sales.toLocaleString() : '-' %>
                            </td>
                            <td class="metric-cell acos">
                                <% if (campaign.metrics && campaign.metrics.acos > 0) { %>
                                    <span class="acos-badge <%= parseFloat(campaign.metrics.acos) < 20 ? 'good' : parseFloat(campaign.metrics.acos) < 40 ? 'medium' : 'bad' %>">
                                        <%= campaign.metrics.acos %>%
                                    </span>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                            <td class="metric-cell roas">
                                <%= campaign.metrics ? campaign.metrics.roas : '-' %>
                            </td>
                            <td>
                                <span class="status-badge <%= campaign.state.toLowerCase() %>">
                                    <%= campaign.state %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <a href="/campaigns/<%= campaign.campaignId %>" class="btn-small">View</a>
                                    <% if (campaign.state === 'ENABLED') { %>
                                        <button onclick="scheduleAdjustment('<%= campaign.campaignId %>', '<%= campaign.name %>')" class="btn-small btn-schedule" title="Schedule Adjustment">⚡</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (campaigns.length === 0) { %>
            <div class="empty-state">
                <p>No campaigns found. Run the seed script to add sample data:</p>
                <code>npm run seed</code>
            </div>
        <% } %>
<script>
    // Handle form submission
    document.getElementById('campaignFilters').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const params = new URLSearchParams(window.location.search);
        
        for (let [key, value] of formData.entries()) {
            if (value) {
                params.set(key, value);
            } else {
                params.delete(key);
            }
        }
        
        window.location.search = params.toString();
    });
    
    // Clear all filters
    function clearFilters() {
        document.getElementById('filterName').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterTargeting').value = '';
        window.location.href = '/campaigns';
    }
    
    // Clear specific filter
    function clearFilter(filterType) {
        const params = new URLSearchParams(window.location.search);
        params.delete(filterType);
        window.location.search = params.toString();
    }
    
    // Clear search input
    function clearSearchInput() {
        document.getElementById('filterName').value = '';
        document.getElementById('filterName').focus();
    }
    
    async function syncCampaigns() {
        // Show custom confirmation modal
        showConfirmationModal(
            'Confirm Sync from Amazon', 
            'Sync campaign data from Amazon? This will fetch the latest campaign information.',
            async () => {
                // Show loading indicator
                const syncBtn = document.querySelector('button[onclick="syncCampaigns()"]');
                const originalText = syncBtn.innerHTML;
                syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Syncing...';
                syncBtn.disabled = true;
                
                try {
                    const response = await fetch('/api/campaigns/sync', { method: 'POST', withCredentials: true });
                    const result = await response.json();
                    
                    // Show notification
                    showNotification(result.message || 'Campaign sync initiated', 'success');
                    
                    // Reload page after a delay to show updated data
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } catch (error) {
                    showNotification('Error syncing campaigns: ' + error.message, 'error');
                } finally {
                    // Restore button
                    syncBtn.innerHTML = originalText;
                    syncBtn.disabled = false;
                }
            }
        );
    }

    async function adjustBids() {
        // Show custom confirmation modal
        showConfirmationModal(
            'Confirm Bid Adjustment', 
            'Manually trigger bid adjustment for all campaigns? This will analyze performance and adjust bids automatically.',
            async () => {
                // Show loading indicator
                const adjustBtn = document.querySelector('button[onclick="adjustBids()"]');
                const originalText = adjustBtn.innerHTML;
                adjustBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adjusting...';
                adjustBtn.disabled = true;
                
                try {
                    const response = await fetch('/api/campaigns/adjust-bids', { method: 'POST',withCredentials: true });
                    const result = await response.json();
                    
                    // Show notification
                    showNotification(result.message || 'Bid adjustment initiated', 'success');
                    
                    // Reload page after a delay to show updated data
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } catch (error) {
                    showNotification('Error adjusting bids: ' + error.message, 'error');
                } finally {
                    // Restore button
                    adjustBtn.innerHTML = originalText;
                    adjustBtn.disabled = false;
                }
            }
        );
    }

    async function scheduleAdjustment(campaignId, campaignName) {
        showConfirmationModal(
            'Schedule Adjustment', 
            `Schedule bid adjustment for "${campaignName}"? This will analyze campaign performance and apply optimization rules.`,
            async () => {
                try {
                    const response = await fetch(`/api/campaigns/${campaignId}/optimize`, { 
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const result = await response.json();
                    
                    if (result.success) {
                        showNotification(result.message, 'success');
                    } else {
                        showNotification(result.message, 'error');
                    }
                } catch (error) {
                    showNotification('Error scheduling adjustment: ' + error.message, 'error');
                }
            }
        );
    }
    
    // Confirmation Modal Functions
    function showConfirmationModal(title, message, onConfirm) {
        // Remove any existing modals
        const existingModal = document.querySelector('.confirmation-modal');
        if (existingModal) existingModal.remove();
        
        // Create modal overlay
        const overlay = document.createElement('div');
        overlay.className = 'modal-overlay';
        
        // Create modal content
        const modal = document.createElement('div');
        modal.className = 'confirmation-modal';
        modal.innerHTML = `
            <div class="modal-content">
                <div class="modal-header">
                    <h3>${title}</h3>
                    <button class="modal-close" onclick="closeConfirmationModal()">×</button>
                </div>
                <div class="modal-body">
                    <p>${message}</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeConfirmationModal()">Cancel</button>
                    <button class="btn btn-danger" onclick="confirmAction()">Confirm</button>
                </div>
            </div>
        `;
        
        // Add to document
        document.body.appendChild(overlay);
        document.body.appendChild(modal);
        window.confirmationCallback = onConfirm;
    }
    
    function closeConfirmationModal() {
        const modal = document.querySelector('.confirmation-modal');
        const overlay = document.querySelector('.modal-overlay');
        
        if (modal) modal.remove();
        if (overlay) overlay.remove();
        
        // Clean up callback
        delete window.confirmationCallback;
    }
    
    function confirmAction() {
        if (window.confirmationCallback) {
            window.confirmationCallback();
        }
        closeConfirmationModal();
    }
    
    // Close modal when clicking outside
    document.addEventListener('click', function(e) {
        const modal = document.querySelector('.confirmation-modal');
        const overlay = document.querySelector('.modal-overlay');
        
        if (overlay && e.target === overlay) {
            closeConfirmationModal();
        }
    });
    
    // Notification function
    function showNotification(message, type = 'info') {
        // Remove any existing notifications
        const existingNotifications = document.querySelectorAll('.notification');
        existingNotifications.forEach(notification => notification.remove());
        
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `notification notification-${type}`;
        notification.innerHTML = `
            <span class="notification-message">${message}</span>
            <button class="notification-close" onclick="this.parentElement.remove()">×</button>
        `;
        
        // Add to top of body
        document.body.appendChild(notification);
        
        // Auto-remove after 5 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.remove();
            }
        }, 5000);
    }
</script>

<style>
/* ROAS cell styling */
.metric-cell.roas {
    color: #059669;
    font-weight: 600;
}
</style>

<%- include('partials/footer') %>
