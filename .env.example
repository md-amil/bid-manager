# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/bid-manager

# Amazon Advertising API Configuration
AMAZON_REGION=us-east-1
AMAZON_CLIENT_ID=your_client_id
AMAZON_CLIENT_SECRET=your_client_secret
AMAZON_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: Set this to enable auto-login without manual OAuth flow
# If set, the app will automatically authenticate using this refresh token
AMAZON_REFRESH_TOKEN=

AMAZON_PROFILE_ID=amzn1.application.88ef1d5d7de94981ae3d5cdd5140e5fc
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Amazon Advertising API Endpoints
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_ADVERTISING_API_URL=https://advertising-api.amazon.com

# Bid Adjustment Configuration
HIGH_ROI_THRESHOLD=3.0
LOW_ROI_THRESHOLD=1.0
BID_INCREASE_PERCENTAGE=15
BID_DECREASE_PERCENTAGE=10
MIN_BID_AMOUNT=0.25
MAX_BID_AMOUNT=10.00
