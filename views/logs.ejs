<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bid Adjustment Logs - Amazon Bid Manager</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <h1 class="logo">📊 Amazon Bid Manager</h1>
            <ul class="nav-links">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/campaigns">Campaigns</a></li>
                <li><a href="/logs" class="active">Logs</a></li>
            </ul>
        </div>
    </nav>
    
    <main class="container">
        <div class="page-header">
            <h2>Bid Adjustment Logs</h2>
            <div class="log-stats">
                <span class="stat success">✓ Success: <%= successCount %></span>
                <span class="stat failed">✗ Failed: <%= failedCount %></span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Campaign ID</th>
                        <th>Keyword</th>
                        <th>Old Bid</th>
                        <th>New Bid</th>
                        <th>Change</th>
                        <th>ROI</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% logs.forEach(log => { %>
                        <tr class="<%= log.status %>">
                            <td>
                                <div class="timestamp">
                                    <%= new Date(log.createdAt).toLocaleDateString() %>
                                    <span class="time"><%= new Date(log.createdAt).toLocaleTimeString() %></span>
                                </div>
                            </td>
                            <td><%= log.campaignId %></td>
                            <td><strong><%= log.keyword %></strong></td>
                            <td>$<%= log.oldBid.toFixed(2) %></td>
                            <td>$<%= log.newBid.toFixed(2) %></td>
                            <td>
                                <% 
                                    const change = ((log.newBid - log.oldBid) / log.oldBid * 100).toFixed(1);
                                    const changeClass = change > 0 ? 'increase' : 'decrease';
                                %>
                                <span class="change <%= changeClass %>">
                                    <%= change > 0 ? '+' : '' %><%= change %>%
                                </span>
                            </td>
                            <td>
                                <span class="roi-badge <%= log.roi >= 3 ? 'high' : log.roi <= 1 ? 'low' : 'medium' %>">
                                    <%= log.roi.toFixed(2) %>
                                </span>
                            </td>
                            <td class="reason"><%= log.reason %></td>
                            <td>
                                <span class="status-badge <%= log.status %>">
                                    <%= log.status %>
                                </span>
                                <% if (log.errorMessage) { %>
                                    <div class="error-message">
                                        <%= log.errorMessage %>
                                    </div>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (logs.length === 0) { %>
            <div class="empty-state">
                <p>No bid adjustment logs yet.</p>
                <p>Logs will appear here after the first bid adjustment runs.</p>
                <a href="/campaigns" class="btn">View Campaigns</a>
            </div>
        <% } %>
    </main>
    
    <footer>
        <div class="container">
            <p>&copy; 2025 Amazon Bid Manager - Automated ROI-based Bidding</p>
        </div>
    </footer>
</body>
</html>
