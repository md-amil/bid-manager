<%- include('partials/header', { currentPage: 'logs', selectedProfile, profiles, title: 'Optimization Logs' }) %>

<div class="page-header">
    <h2>Optimization Logs</h2>
    <div class="log-stats">
        <span class="stat success">✓ Success: <%= successCount %></span>
        <span class="stat failed">✗ Failed: <%= failedCount %></span>
    </div>
</div>

<!-- Filters Section -->
<div class="filters-section">
    <div class="filters-container">
        <form class="filter-form" method="GET" action="/logs">
            <div class="filter-inputs">
                <div class="filter-group">
                    <label><i class="fas fa-filter"></i> Entity Type</label>
                    <div class="select-wrapper">
                        <select name="entityType" class="status-select" id="entityTypeFilter">
                            <option value="">All Entities</option>
                            <option value="CAMPAIGN" <%= filterEntityType === 'CAMPAIGN' ? 'selected' : '' %>>Campaign</option>
                            <option value="AD_GROUP" <%= filterEntityType === 'AD_GROUP' ? 'selected' : '' %>>Ad Group</option>
                            <option value="KEYWORD" <%= filterEntityType === 'KEYWORD' ? 'selected' : '' %>>Keyword</option>
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>
                </div>
                
                <div class="filter-group">
                    <label><i class="fas fa-tag"></i> Type</label>
                    <div class="select-wrapper">
                        <select name="type" class="status-select" id="typeFilter">
                            <option value="">All Types</option>
                            <option value="BID_UPDATE" <%= filterType === 'BID_UPDATE' ? 'selected' : '' %>>Bid Update</option>
                            <option value="BUDGET_UPDATE" <%= filterType === 'BUDGET_UPDATE' ? 'selected' : '' %>>Budget Update</option>
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>
                </div>
                
                <div class="filter-group">
                    <label><i class="fas fa-check-circle"></i> Status</label>
                    <div class="select-wrapper">
                        <select name="status" class="status-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="success" <%= filterStatus === 'success' ? 'selected' : '' %>>Success</option>
                            <option value="failed" <%= filterStatus === 'failed' ? 'selected' : '' %>>Failed</option>
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>
                </div>
                
                <div class="filter-actions">
                    <button type="submit" class="btn-apply">
                        <i class="fas fa-search"></i>
                        Apply Filters
                    </button>
                    <button type="button" class="btn-clear" onclick="clearFilters()">
                        <i class="fas fa-times"></i>
                        Clear
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<% if (logs && logs.length > 0) { %>
    <div class="table-responsive">
        <table class="log-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Entity Type</th>
                    <th>Campaign</th>
                    <th>Action</th>
                    <th>Old Value</th>
                    <th>New Value</th>
                    <th>Change</th>
                    <th>Reason</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(log => { %>
                    <tr class="<%= log.status %>">
                        <td>
                            <div class="timestamp">
                                <%= new Date(log.createdAt).toLocaleDateString() %>
                                <span class="time"><%= new Date(log.createdAt).toLocaleTimeString() %></span>
                            </div>
                        </td>
                        <td>
                            <span class="entity-badge <%= log.entityType.toLowerCase() %>">
                                <%= log.entityType %>
                            </span>
                        </td>
                        <td>
                            <% if (log.entityType === 'CAMPAIGN' && campaignMap.has(log.entityId)) { %>
                                <% const campaign = campaignMap.get(log.entityId); %>
                                <a href="/campaigns/<%= log.entityId %>" class="campaign-link">
                                    <%= campaign.name %>
                                </a>
                                <div class="campaign-id-small">ID: <%= log.entityId %></div>
                            <% } else if (log.entityType === 'CAMPAIGN') { %>
                                <span class="text-muted">Campaign <%= log.entityId %></span>
                            <% } else { %>
                                <span class="text-muted">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (log.action) { %>
                                <span class="action-badge"><%= log.action %></span>
                            <% } else { %>
                                <span class="text-muted">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (log.oldValue !== null && log.oldValue !== undefined) { %>
                                $<%= log.oldValue.toFixed(2) %>
                            <% } else { %>
                                <span class="text-muted">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (log.newValue !== null && log.newValue !== undefined) { %>
                                $<%= log.newValue.toFixed(2) %>
                            <% } else { %>
                                <span class="text-muted">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (log.adjustmentPercentage !== null && log.adjustmentPercentage !== undefined) { %>
                                <% 
                                    const changeClass = log.adjustmentPercentage > 0 ? 'increase' : 'decrease';
                                %>
                                <span class="change <%= changeClass %>">
                                    <%= log.adjustmentPercentage > 0 ? '+' : '' %><%= log.adjustmentPercentage.toFixed(1) %>%
                                </span>
                            <% } else if (log.oldValue && log.newValue) { %>
                                <% 
                                    const change = ((log.newValue - log.oldValue) / log.oldValue * 100).toFixed(1);
                                    const changeClass = change > 0 ? 'increase' : 'decrease';
                                %>
                                <span class="change <%= changeClass %>">
                                    <%= change > 0 ? '+' : '' %><%= change %>%
                                </span>
                            <% } else { %>
                                <span class="text-muted">-</span>
                            <% } %>
                        </td>
                        <td class="reason-cell"><%= log.reason %></td>
                        <td>
                            <span class="status-badge <%= log.status %>">
                                <%= log.status %>
                            </span>
                            <% if (log.errorMessage) { %>
                                <div class="error-message">
                                    <%= log.errorMessage %>
                                </div>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } else { %>
    <div class="empty-state">
        <p>No optimization logs yet.</p>
        <p>Logs will appear here after optimization runs.</p>
        <a href="/campaigns" class="btn">View Campaigns</a>
    </div>
<% } %>

<script>
function clearFilters() {
    window.location.href = '/logs';
}
</script>

<%- include('partials/footer') %>
