<%- include('partials/header', { currentPage: 'dashboard', selectedProfile, profiles }) %>

<h2>Dashboard</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Campaigns</h3>
                <p class="stat-value"><%= stats.totalCampaigns %></p>
            </div>
            <div class="stat-card">
                <h3>Active Campaigns</h3>
                <p class="stat-value"><%= stats.activeCampaigns %></p>
            </div>
            <div class="stat-card">
                <h3>Total Spend</h3>
                <p class="stat-value">$<%= stats.totalSpend.toFixed(2) %></p>
            </div>
            <div class="stat-card">
                <h3>Total Sales</h3>
                <p class="stat-value">$<%= stats.totalSales.toFixed(2) %></p>
            </div>
            <div class="stat-card">
                <h3>Average ROI</h3>
                <p class="stat-value <%= stats.averageROI >= 3 ? 'high-roi' : stats.averageROI <= 1 ? 'low-roi' : '' %>">
                    <%= stats.averageROI.toFixed(2) %>
                </p>
            </div>
        </div>

        <div class="section">
            <h3>Recent Campaigns</h3>
            <div class="table-responsive">
                <table class="campaign-table">
                    <thead>
                        <tr>
                             <th>Campaign ID</th>
                            
                            <th>Campaign</th>
                            <th>Budget</th>
                            <th>ROI</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% campaigns.slice(0, 5).forEach(campaign => { %>
                            <tr>
                                <td><%= campaign.campaignId %></td>
                                <td><%= campaign.name %></td>

                                                                <td>$<%= campaign.budget.budget %></td>

                                <td>
                                    <% const roi = campaign.roi || (campaign.spend > 0 ? campaign.sales / campaign.spend : 0); %>
                                    <span class="roi-badge <%= roi >= 3 ? 'high' : roi <= 1 ? 'low' : 'medium' %>">
                                        <%= roi.toFixed(2) %>
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge <%= campaign.state %>">
                                        <%= campaign.state %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/campaigns/<%= campaign.campaignId %>" class="btn-small">View</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <a href="/campaigns" class="btn">View All Campaigns</a>
        </div>

        <div class="section">
            <h3>Recent Bid Adjustments</h3>
            <div class="table-responsive">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Campaign</th>
                            <th>Keyword</th>
                            <th>Old Bid</th>
                            <th>New Bid</th>
                            <th>ROI</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentLogs.forEach(log => { %>
                            <tr>
                                <td><%= new Date(log.createdAt).toLocaleString() %></td>
                                <td><%= log.campaignId %></td>
                                <td><%= log.keyword %></td>
                                <td>$<%= log.oldBid.toFixed(2) %></td>
                                <td>$<%= log.newBid.toFixed(2) %></td>
                                <td>
                                    <span class="roi-badge <%= log.roi >= 3 ? 'high' : log.roi <= 1 ? 'low' : 'medium' %>">
                                        <%= log.roi.toFixed(2) %>
                                    </span>
                                </td>
                                <td><%= log.reason %></td>
                                <td>
                                    <span class="status-badge <%= log.status %>">
                                        <%= log.status %>
                                    </span>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <a href="/logs" class="btn">View All Logs</a>
        </div>
<%- include('partials/footer') %>
