<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Amazon Advertising Profiles' %> - Amazon Bid Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <h1 class="logo">Amazon Bid Manager</h1>
            <ul class="nav-links">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/campaigns">Campaigns</a></li>
                <li><a href="/profiles" class="active">Profiles</a></li>
                <li><a href="/logs">Logs</a></li>
                <li><a href="/auth/logout" style="color: #fed7d7;">Logout</a></li>
            </ul>
        </div>
    </nav>
    
    <main class="container">
<div class="container">
  <div class="header-section">
    <h1><i class="fas fa-user-circle"></i> Amazon Advertising Profiles</h1>
    <p class="subtitle">Manage your Amazon Advertising account profiles</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error">
      <i class="fas fa-exclamation-triangle"></i>
      <%= error %>
    </div>
  <% } %>

  <% if (profiles && profiles.length > 0) { %>
    <div class="profiles-grid">
      <% profiles.forEach(profile => { %>
        <div class="profile-card">
          <div class="profile-header">
            <div class="profile-icon">
              <i class="fas fa-<%= profile.accountInfo.type === 'seller' ? 'store' : profile.accountInfo.type === 'vendor' ? 'building' : 'users' %>"></i>
            </div>
            <div class="profile-info">
              <h3><%= profile.accountInfo.name %></h3>
              <span class="profile-type"><%= profile.accountInfo.type.toUpperCase() %></span>
            </div>
          </div>
          
          <div class="profile-details">
            <div class="detail-row">
              <span class="label">Profile ID:</span>
              <span class="value"><%= profile.profileId %></span>
            </div>
            <div class="detail-row">
              <span class="label">Country:</span>
              <span class="value">
                <i class="fas fa-flag"></i>
                <%= profile.countryCode %>
              </span>
            </div>
            <div class="detail-row">
              <span class="label">Currency:</span>
              <span class="value">
                <i class="fas fa-dollar-sign"></i>
                <%= profile.currencyCode %>
              </span>
            </div>
            <div class="detail-row">
              <span class="label">Timezone:</span>
              <span class="value">
                <i class="fas fa-clock"></i>
                <%= profile.timezone %>
              </span>
            </div>
            <% if (profile.dailyBudget) { %>
              <div class="detail-row">
                <span class="label">Daily Budget:</span>
                <span class="value budget">
                  <i class="fas fa-wallet"></i>
                  <%= profile.currencyCode %> <%= profile.dailyBudget.toFixed(2) %>
                </span>
              </div>
            <% } %>
          </div>

          <div class="profile-actions">
            <a href="/profiles/<%= profile.profileId %>" class="btn btn-primary">
              <i class="fas fa-eye"></i>
              View Details
            </a>
            <a href="/campaigns?profileId=<%= profile.profileId %>" class="btn btn-secondary">
              <i class="fas fa-bullhorn"></i>
              View Campaigns
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else if (!error) { %>
    <div class="empty-state">
      <i class="fas fa-user-slash"></i>
      <h3>No Profiles Found</h3>
      <p>No Amazon Advertising profiles are available for your account.</p>
      <a href="/campaigns" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i>
        Back to Campaigns
      </a>
    </div>
  <% } %>

  <div class="actions-section">
    <a href="/campaigns" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i>
      Back to Campaigns
    </a>
    <button onclick="refreshProfiles()" class="btn btn-primary">
      <i class="fas fa-sync-alt"></i>
      Refresh Profiles
    </button>
  </div>
</div>

<style>
.profiles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  gap: 20px;
  margin: 20px 0;
}

.profile-card {
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 24px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.profile-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 2px solid #f0f0f0;
}

.profile-icon {
  width: 50px;
  height: 50px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
}

.profile-icon i {
  color: white;
  font-size: 20px;
}

.profile-info h3 {
  margin: 0 0 4px 0;
  color: #333;
  font-size: 18px;
  font-weight: 600;
}

.profile-type {
  background: #e3f2fd;
  color: #1976d2;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 500;
}

.profile-details {
  margin-bottom: 20px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row .label {
  color: #666;
  font-weight: 500;
  font-size: 14px;
}

.detail-row .value {
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

.detail-row .value i {
  color: #666;
  font-size: 12px;
}

.budget {
  color: #4caf50 !important;
}

.profile-actions {
  display: flex;
  gap: 10px;
}

.profile-actions .btn {
  flex: 1;
  text-align: center;
  padding: 10px 16px;
  font-size: 14px;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #666;
}

.empty-state i {
  font-size: 64px;
  color: #ddd;
  margin-bottom: 20px;
}

.empty-state h3 {
  margin: 0 0 10px 0;
  color: #333;
}

.actions-section {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #eee;
}

@media (max-width: 768px) {
  .profiles-grid {
    grid-template-columns: 1fr;
  }
  
  .actions-section {
    flex-direction: column;
    gap: 10px;
  }
  
  .profile-actions {
    flex-direction: column;
  }
}
</style>

<script>
async function refreshProfiles() {
  const button = event.target;
  const originalText = button.innerHTML;
  
  button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Refreshing...';
  button.disabled = true;
  
  try {
    const response = await fetch('/profiles/api');
    if (response.ok) {
      location.reload();
    } else {
      throw new Error('Failed to refresh profiles');
    }
  } catch (error) {
    alert('Failed to refresh profiles. Please try again.');
    console.error('Error refreshing profiles:', error);
  } finally {
    button.innerHTML = originalText;
    button.disabled = false;
  }
}
</script>
    </main>
    
    <footer>
        <div class="container">
            <p>&copy; 2025 Amazon Bid Manager - Automated ROI-based Bidding</p>
        </div>
    </footer>
</body>
</html>